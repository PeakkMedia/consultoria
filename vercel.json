{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/testimonios",
      "destination": "/testimonios.html"
    },
    {
      "source": "/calendario",
      "destination": "/calendario.html"
    },
    {
      "source": "/calendario-proyeccion",
      "destination": "/calendario-proyeccion.html"
    },
    {
      "source": "/confirmacion-pre-llamada",
      "destination": "/confirmacion-pre-llamada.html"
    },
    {
      "source": "/confirmacion-pre-llamada-proyeccion",
      "destination": "/confirmacion-pre-llamada-proyeccion.html"
    },
    {
      "source": "/politicas-de-privacidad-page",
      "destination": "/politicas-de-privacidad-page.html"
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/terminos-y-condiciones.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/confirma-tu-llamada-video",
      "destination": "/confirma-tu-llamada-video.html"
    }
    {
      "source": "/onboarding-2",
      "destination": "/onboarding-listo.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
